import { ComboBox, ListView, ScrollView, Palette } from "std-widgets.slint";

// 导出给 Rust：暗色下标准控件的配色只能从宿主语言设置
export { Palette }

export struct Shot { name: string, sub: string, meta: string, tone: int }
export struct OutNode { checked: bool, path: string, ntype: string, category: string, output: string, range: string, status: string, tone: int }
export struct QTask { nid: string, title: string, shot: string, category: string, range: string, status: string, progress: int, frames: string, tone: int }

// 设备面板一行：一台参与渲染的机器（或本机自己的执行槽）
export struct Device { host: string, state: string, slots: string, houdini: string, job: string, tone: int }

// ─────────────────────────────────────────────────────────────
// 主题 token：暗房仪器风。深石墨底 + 暖灰字 + 单一琥珀强调。
// 不用纯黑/纯白，暗色下也不上高饱和霓虹。
// ─────────────────────────────────────────────────────────────
export global Theme {
    in-out property <bool> dark: true;

    // 底
    out property <color> canvas: dark ? #101216 : #f3f2ef;
    out property <color> panel: dark ? #171a1f : #ffffff;
    out property <color> well: dark ? #1d2127 : #f7f6f3;
    // 输入框聚焦时的底：暖调提亮一档，配琥珀描边说明"正在编辑这一格"
    out property <color> well-focus: dark ? #3a3126 : #fdf4e4;
    out property <color> hover: dark ? #232830 : #efede8;
    out property <color> row-alt: dark ? #1a1d23 : #faf9f6;
    out property <color> border: dark ? #262b33 : #e4e2dc;
    out property <color> border-2: dark ? #363c46 : #cecbc3;

    // 字（次要文字再提一档亮度，小字号下也读得清）
    out property <color> text: dark ? #f0ede6 : #14130f;
    out property <color> text-2: dark ? #bdb8ae : #4b4842;
    out property <color> text-3: dark ? #969188 : #68645c;

    // 强调（琥珀）
    out property <color> accent: dark ? #dfa147 : #a9690f;
    out property <color> accent-hi: dark ? #ecb264 : #92590a;
    out property <color> accent-fg: dark ? #171008 : #ffffff;
    out property <color> accent-soft: dark ? #2a2318 : #f7ecda;
    out property <color> accent-line: dark ? #4d3d26 : #e2cba6;
    // 文本选区底：accent-soft 与输入框底色几乎同色，选中文字在暗色下看不出来，
    // 选区单独用一档更亮的暖色，浅字压上去仍读得清
    out property <color> select: dark ? #7d6340 : #dcc09b;

    // 状态
    out property <color> ok: dark ? #77b97f : #3f7d3c;
    out property <color> ok-soft: dark ? #18241b : #e9f3e7;
    out property <color> ok-line: dark ? #2f4634 : #c4ddc1;

    out property <color> run: dark ? #6aa8e0 : #1e6ea8;
    out property <color> run-soft: dark ? #16222e : #e5eff9;
    out property <color> run-line: dark ? #2b4258 : #bcd6ea;

    out property <color> err: dark ? #e17d70 : #a83a30;
    out property <color> err-soft: dark ? #2a1a18 : #fbe9e6;
    out property <color> err-line: dark ? #4a2b28 : #eec6c0;

    out property <color> teal: dark ? #5cb3a2 : #0f6e56;
    out property <color> teal-soft: dark ? #152523 : #e2f4ee;
    out property <color> teal-line: dark ? #2a4642 : #b8ddd2;

    out property <color> mute: dark ? #9a968d : #5f5e59;
    out property <color> mute-soft: dark ? #21252b : #f1efe9;
    out property <color> mute-line: dark ? #333944 : #ddd9d0;
}

// tone: 0 灰 / 1 蓝(运行) / 2 绿(成功) / 3 红(失败) / 4 琥珀 / 5 青
global Tone {
    public pure function fg(t: int) -> color {
        return t == 1 ? Theme.run : t == 2 ? Theme.ok : t == 3 ? Theme.err : t == 4 ? Theme.accent : t == 5 ? Theme.teal : Theme.mute;
    }
    public pure function bg(t: int) -> color {
        return t == 1 ? Theme.run-soft : t == 2 ? Theme.ok-soft : t == 3 ? Theme.err-soft : t == 4 ? Theme.accent-soft : t == 5 ? Theme.teal-soft : Theme.mute-soft;
    }
    public pure function line(t: int) -> color {
        return t == 1 ? Theme.run-line : t == 2 ? Theme.ok-line : t == 3 ? Theme.err-line : t == 4 ? Theme.accent-line : t == 5 ? Theme.teal-line : Theme.mute-line;
    }
}

// ─────────────────────────────────────────────────────────────
// 统一字体配置：Rust 侧从 meta 表读入，所有字号经 size() 缩放
// ─────────────────────────────────────────────────────────────
export global Fonts {
    /// 正文字体；空串 = 系统默认
    in-out property <string> body: "";
    /// 等宽字体（路径、帧号、日志）
    in-out property <string> mono: "Consolas";
    /// 字号倍率
    in-out property <float> scale: 1.15;

    public pure function size(base: length) -> length {
        return base * scale;
    }
}

// 等宽小标签，用于面板头的拉丁标记（仪器铭牌感）
component Tag inherits Text {
    in-out property <color> tint: Theme.text-3;
    font-family: Fonts.mono;
    font-size: Fonts.size(10px);
    letter-spacing: 0.9px;
    color: root.tint;
    vertical-alignment: center;
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <int> tone: 0;
    in property <length> w: 44px;
    width: w;
    height: 17px;
    border-radius: 4px;
    background: Tone.bg(tone);
    border-width: 1px;
    border-color: Tone.line(tone);
    Text {
        text: root.label;
        color: Tone.fg(root.tone);
        font-size: Fonts.size(10.5px);
        font-weight: 500;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 可点的小标签：hover 有反馈，激活态用琥珀
component Chip inherits Rectangle {
    in property <string> label;
    in-out property <bool> active: false;
    in property <length> w: 46px;
    callback clicked();
    width: w;
    height: 20px;
    border-radius: 5px;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);
    border-width: 1px;
    border-color: active ? Theme.accent-line : (ta.has-hover ? Theme.border-2 : Theme.border-2);
    Text {
        text: root.label;
        font-size: Fonts.size(11px);
        color: root.active ? Theme.accent : Theme.text-2;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 按钮：1 主(琥珀实心) / 2 次(描边) / 3 危险(红描边)
component TBtn inherits Rectangle {
    in property <string> label;
    in property <int> kind: 2;
    in property <length> w: 58px;
    in property <length> h: 25px;
    callback clicked();
    width: w;
    height: h;
    border-radius: 6px;
    background: kind == 1 ? (ta.has-hover ? Theme.accent-hi : Theme.accent)
              : kind == 3 ? (ta.has-hover ? Theme.err-soft : transparent)
              : (ta.has-hover ? Theme.hover : Theme.well);
    border-width: 1px;
    border-color: kind == 1 ? transparent : (kind == 3 ? Theme.err-line : Theme.border);
    opacity: ta.pressed ? 0.72 : 1;
    Text {
        text: root.label;
        font-size: Fonts.size(11.5px);
        font-weight: 600;
        color: kind == 1 ? Theme.accent-fg : (kind == 3 ? Theme.err : Theme.text-2);
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 紧凑下拉：底色 / 描边 / 圆角 / 字重全部与 TBtn 同源，只比按钮多一枚小箭头，
// 这样「并发 / 重试」和右侧几个按钮是同一尺寸、同一条水平中线。
// 不用 std 的 ComboBox：它自带内边距和较大的字号，56~64px 装不下「2 次」，还会比按钮高出一头。
component MiniSel inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index: 0;
    in property <length> w: 64px;
    callback picked(int);

    width: w;
    height: 25px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : Theme.well;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-2 : Theme.border;

    Text {
        x: 8px;
        width: parent.width - 8px - 20px;
        height: parent.height;
        text: root.options[root.index];
        font-size: Fonts.size(11.5px);
        font-weight: 600;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    // 手绘 chevron，不依赖字体里有没有 ▾
    Path {
        x: parent.width - 17px;
        y: (parent.height - 4px) / 2;
        width: 8px;
        height: 5px;
        commands: "M 0 0 L 4 4.2 L 8 0";
        stroke: Theme.text-3;
        stroke-width: 1.2px;
        fill: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 96px);
        height: root.options.length * 24px + 8px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.border-2;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for o[i] in root.options : Rectangle {
                    height: 24px;
                    border-radius: 5px;
                    background: row-ta.has-hover ? Theme.hover
                              : (i == root.index ? Theme.accent-soft : transparent);
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: o;
                        font-size: Fonts.size(11.5px);
                        color: i == root.index ? Theme.accent : Theme.text-2;
                        vertical-alignment: center;
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.index = i;
                            root.picked(i);
                            pop.close();
                        }
                    }
                }
            }
        }
    }
}

// 图标按钮（↑ ↓ ×）：无文字底，hover 才显形
component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <int> kind: 0;
    callback clicked();
    width: 17px;
    height: 17px;
    border-radius: 4px;
    background: ta.has-hover ? (kind == 1 ? Theme.err-soft : Theme.hover) : transparent;
    Text {
        text: root.glyph;
        font-size: Fonts.size(11.5px);
        color: kind == 1 ? Theme.err : Theme.text-3;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 排序箭头：↑↓ 字符在界面字体里常缺字形，11px 下又细又灰，几乎看不见。
// 改成实心三角形矢量图，颜色用 text-2（比 text-3 亮一档），hover 变琥珀；
// 到顶 / 到底时置灰，一眼就能看出这行还能不能移动。
component ArrowBtn inherits Rectangle {
    in property <bool> dir-up: true;
    in property <bool> can-move: true;
    callback clicked();
    width: 19px;
    height: 19px;
    border-radius: 4px;
    opacity: root.can-move ? 1 : 0.32;
    background: root.can-move && ta.has-hover ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: root.can-move && ta.has-hover ? Theme.accent-line : transparent;
    Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 7px) / 2;
        width: 10px;
        height: 7px;
        fill: ta.has-hover ? Theme.accent : Theme.text-2;
        commands: root.dir-up ? "M 0 7 L 5 0 L 10 7 Z" : "M 0 0 L 5 7 L 10 0 Z";
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.can-move) { root.clicked(); } }
    }
}

component Check inherits Rectangle {
    in property <bool> on: false;
    callback toggled();
    // 画面上仍是 13px 的小方框，但整体做成 24px 热区，免得点不中
    width: 24px;
    height: 24px;
    background: transparent;
    Rectangle {
        x: (parent.width - 13px) / 2;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        border-radius: 3.5px;
        background: root.on ? Theme.accent : (ta.has-hover ? Theme.hover : transparent);
        border-width: 1px;
        border-color: root.on ? Theme.accent : Theme.border-2;
        // 不用 ✓ 字符：界面字体里是缺字形的方块，改成矢量勾
        Path {
            x: 2px;
            y: 2.5px;
            width: 9px;
            height: 8px;
            commands: "M 0 4.4 L 2.9 7.2 L 8.6 0.9";
            stroke: Theme.accent-fg;
            stroke-width: 1.8px;
            visible: root.on;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// 输入框的跨端小动作。双击「整段选中」Slint 自己做不到——TextInput 的双击是按「词」选的，
// 帧范围 "1-240" 只会选中 "1" 或 "240"；所以由 Rust 在窗口过程里数双击，把双击点的窗口坐标
// （逻辑像素）连同计数器写进这里，各个 Field 自己判断是否被命中。
export global FieldActions {
    /// 双击次数，每次 +1（坐标相同时也要能再次触发）
    in-out property <int> tick: 0;
    /// 双击点的窗口坐标，逻辑像素
    in-out property <int> x: 0;
    in-out property <int> y: 0;
}

// 自绘输入框：避免原生控件在暗色下风格割裂
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> w: 120px;
    in property <length> h: 21px;
    in property <bool> centered: false;
    /// 内容还不合法：只把描边染红，绝不改写输入框里的文字，也不打断输入
    in property <bool> invalid: false;
    /// 每次文本变化都会触发（打字过程中用，别在这里做校验/写库）
    callback edited(string);
    /// 回车或失焦才触发：只有这里的结果才允许写回模型
    callback committed(string);
    /// 转发 FieldActions.tick，才能用 changed 监听（Slint 的 changed 只认裸标识符）
    private property <int> dbl-tick: FieldActions.tick;
    /// 单独提一手，才能在组件体里 changed（不能直接 changed ti.has-focus）
    private property <bool> focused: ti.has-focus;
    width: w;
    height: h;
    border-radius: 5px;
    // 点中就亮：底色转暖调 + 描边转琥珀，一眼看出正在编辑哪一格
    background: ti.has-focus ? Theme.well-focus : Theme.well;
    animate background { duration: 110ms; easing: ease-out; }
    border-width: 1px;
    // 不合法优先染红，其次才是聚焦态
    border-color: root.invalid ? Theme.err : (ti.has-focus ? Theme.accent : Theme.border);
    // 双击整段选中：只有被双击命中、且正在编辑的那一格才动，别的格不响应
    changed dbl-tick => {
        if (ti.has-focus
            && FieldActions.x * 1px >= self.absolute-position.x
            && FieldActions.x * 1px <= self.absolute-position.x + self.width
            && FieldActions.y * 1px >= self.absolute-position.y
            && FieldActions.y * 1px <= self.absolute-position.y + self.height) {
            ti.select-all();
        }
    }
    // 失焦即提交：原来不提交的话，用户改完直接点「开始」会用到旧值
    changed focused => {
        if (!root.focused) {
            root.committed(ti.text);
        }
    }
    // TextInput 没有 placeholder 属性，用一层文字兜底
    Text {
        x: 7px;
        y: 0;
        width: parent.width - 14px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.centered ? center : left;
        text: root.placeholder;
        font-family: Fonts.mono;
        font-size: Fonts.size(11px);
        color: Theme.text-3;
        visible: ti.text == "";
    }
    ti := TextInput {
        x: 6px;
        y: 0;
        width: parent.width - 12px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.centered ? center : left;
        font-family: Fonts.mono;
        font-size: Fonts.size(11px);
        color: Theme.text;
        selection-background-color: Theme.select;
        selection-foreground-color: Theme.text;
        text <=> root.text;
        single-line: true;
        edited => { root.edited(self.text); }
        // 回车提交；失焦走上面的 changed focused
        accepted => { root.committed(self.text); }
    }
}

component Progress inherits Rectangle {
    in property <int> value: 0;
    in property <int> tone: 1;
    height: 2px;
    border-radius: 1px;
    background: Theme.border;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        border-radius: 1px;
        width: parent.width * (Math.max(0, Math.min(100, root.value)) * 1.0 / 100.0);
        background: Tone.fg(root.tone);
        animate width { duration: 240ms; easing: ease-out; }
    }
}

// 暗色开关：滑块位置反映状态
component ThemeSwitch inherits Rectangle {
    in-out property <bool> on: true;
    callback toggled();
    width: 32px;
    height: 17px;
    border-radius: 8.5px;
    background: on ? Theme.accent-soft : Theme.row-alt;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.border-2;
    Rectangle {
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        y: 2px;
        x: root.on ? root.width - 14px : 3px;
        background: root.on ? Theme.accent : Theme.text-3;
        animate x { duration: 160ms; easing: ease-out; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component VRule inherits Rectangle {
    width: 1px;
    height: 16px;
    background: Theme.border;
}

export component AppWindow inherits Window {
    title: "Houdini 渲染队列";
    // 标题栏 / 任务栏图标：与 exe 内嵌图标（assets/app.ico）同一套设计
    icon: @image-url("../assets/app.png");
    // 注意：这里**不要**写 width / height。在 Window 上写死初始尺寸会让组件的
    // layout-info 变成 min == max（实测 min=1600 max=1600），winit 后端据此把窗口
    // 设成不可缩放（没有 WS_THICKFRAME、没有最大化按钮）。
    // 初始尺寸改由 Rust 侧 set_size（默认 1600x820，优先用上次关闭时的尺寸）。
    // min-height 兜住下限：再矮下去四栏就被压成一条缝（只约束 min，不影响可缩放）
    min-height: 640px;
    background: Theme.canvas;
    // 统一字体入口：未单独指定字体的文字都继承这里
    default-font-family: Fonts.body;
    default-font-size: Fonts.size(11px);

    in property <[string]> font-families;
    in-out property <int> font-family-index: 0;
    in property <[string]> font-size-labels;
    in-out property <int> font-size-index: 1;
    in-out property <bool> font-panel-open: false;
    callback font-changed();
    /// 字体下拉的过滤词（本机上百款字体，靠下拉翻太费劲）
    in-out property <string> font-filter: "";
    callback font-filter-changed(string);

    /// 本软件自身的版本号（运行时由 Rust 侧按 CARGO_PKG_VERSION 填，形如 v0.1.0）
    in property <string> app-version: "v0.0.0";

    /// 当前工程的版本是否被手动锁定
    in property <bool> version-pinned: false;
    /// 当前工程可选/已选的 Houdini 版本：第 0 项是「自动」，其余为本机安装
    in property <[string]> version-options;
    in-out property <int> version-index: 0;
    /// 显示文案与真实值分开：1/2/3/4/6/8 不是连续整数，不能拿下标当并发数
    /// （曾经用 index+1 换算，选「6」实际只跑 5、选「8」实际跑 6）
    in property <[string]> concurrency-options: ["1", "2", "3", "4", "6", "8"];
    in property <[int]> concurrency-values: [1, 2, 3, 4, 6, 8];
    in-out property <int> concurrency-index: 0;
    in property <[string]> retry-options: ["不重试", "1 次", "2 次", "3 次"];
    in-out property <int> retry-index: 2;

    in-out property <[Shot]> shots;
    in-out property <int> current-shot: 0;
    in property <[OutNode]> nodes;
    in property <[QTask]> queue;
    in property <string> log-text;
    in property <string> project-count;
    in property <string> queue-count;
    in property <string> shot-title;
    in property <string> status-text;
    /// 顶栏状态灯：0 空闲 / 1 运行 / 3 有失败 / 4 待执行
    in property <int> status-tone: 0;
    /// 底部状态栏：当前选中 hip 的完整路径（空串 = 还没导入工程）
    in property <string> status-hip;
    /// 底部状态栏右侧信息：Houdini 版本 / 节点统计
    in property <string> status-meta;
    in-out property <bool> follow-log: true;
    in-out property <int> filter-index: 0;
    in-out property <bool> only-unadded: false;
    /// 「重新开始」已进入待确认状态：4 秒内再点一次才真正重跑整批
    in-out property <bool> restart-armed: false;
    in property <string> node-empty-hint;
    /// 帧范围输入框里不合法的那一行（-1 = 没有）：只影响描边颜色，不改数据
    in-out property <int> range-invalid: -1;
    /// 有文件正悬停在窗口上（由 Rust 侧 OLE DragEnter/DragLeave 驱动）
    in-out property <bool> drag-hover: false;

    // ── 多机执行 ──
    /// 设备面板开关
    in-out property <bool> devices-open: false;
    /// 设备列表（本机槽位 + 已接入的 worker）
    in-out property <[Device]> devices;
    /// 顶栏按钮上的文字，形如「设备 2」
    in-out property <string> device-label: "设备";
    /// 面板底部那行提示（监听地址 / 未开启时的说明）
    in-out property <string> device-hint: "";
    callback toggle-devices();

    // 日志跟随：有新日志时把日志视图贴到最底部（超出范围由 Flickable 自行夹紧）
    changed log-text => {
        if (follow-log) {
            log-sv.content-y = min(0px, log-sv.visible-height - log-sv.content-height);
        }
    }
    // 重新打开「跟随」时立刻跳回底部
    changed follow-log => {
        if (follow-log) {
            log-sv.content-y = min(0px, log-sv.visible-height - log-sv.content-height);
        }
    }

    // 「重新开始」的确认窗口：点亮后 4 秒内没再点一次，就自动退回原状
    restart-timer := Timer {
        interval: 4s;
        running: false;
        triggered => {
            root.restart-armed = false;
            restart-timer.running = false;
        }
    }

    callback add-files();
    callback drop-transfer(data: data-transfer);
    callback shot-selected(int);
    callback remove-project(int);
    callback toggle-node(int);
    callback range-edited(int, string);
    /// 回车 / 失焦提交帧范围，只有这里的结果才写回模型
    callback range-committed(int, string);
    callback search-changed(string);
    callback filter-changed(int);
    callback toggle-unadded();
    callback clear-finished();
    callback restart-all();
    callback start-all();
    callback pause-all();
    callback cancel-all();
    callback task-cancel(string);
    callback task-up(string);
    callback task-down(string);
    callback export-log();
    callback concurrency-changed(int);
    callback retry-changed(int);
    callback select-all(bool);
    callback reanalyze();
    callback version-changed(int);
    callback toggle-theme();


    // 根内容铺满窗口。这里**不能**写 width: root.width / height: root.height：
    // 根元素的 layout-info 会因此得到 min == max == 当前窗口尺寸，winit 后端据此判定
    // 「窗口不可缩放」并把 WS_THICKFRAME / WS_MAXIMIZEBOX 全摘掉（用户看到的就是拖不动、没有最大化）。
    // 不给尺寸：Window 的第一层子元素天生铺满窗口，下面全靠布局的 stretch 分配空间。
    // （同理，里面任何 `root.width - Npx` 的派生宽度也会把窗口钉死，一律改成 stretch）
    Rectangle {
        background: transparent;

        VerticalLayout {
            padding-top: 11px;
            padding-bottom: 11px;
            padding-left: 13px;
            padding-right: 13px;
            spacing: 9px;

            // ── 顶栏 ──
            Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;

                        // 队列铭牌
                        Rectangle {
                            width: 21px;
                            height: 21px;
                            border-radius: 6px;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent-line;
                            VerticalLayout {
                                x: 6px;
                                y: 5px;
                                width: 9px;
                                spacing: 2px;
                                Rectangle { height: 2px; border-radius: 1px; background: Theme.accent; }
                                Rectangle { height: 2px; border-radius: 1px; background: Theme.accent; width: 6px; }
                                Rectangle { height: 2px; border-radius: 1px; background: Theme.accent; width: 4px; }
                            }
                        }

                        VerticalLayout {
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: "Houdini 渲染队列";
                                font-size: Fonts.size(14px);
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            // 铭牌下方一行小字：直接显示当前软件版本号（替代原来的「LOCAL · 本机后台」）
                            Tag {
                                text: root.app-version;
                                letter-spacing: 0.2px;
                            }
                        }

                        // 运行状态：一盏小灯 + 一句描述，一眼看清队列在干什么。
                        // 灯和文字装在同一个盒子里各自居中，避免各自被布局顶到不同高度
                        Rectangle {
                            width: 12px + status-txt.preferred-width;
                            height: Fonts.size(13px) + 6px;
                            Rectangle {
                                x: 0;
                                y: (parent.height - 6px) / 2;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Tone.fg(root.status-tone);
                            }
                            status-txt := Text {
                                x: 12px;
                                y: (parent.height - self.height) / 2;
                                text: root.status-text;
                                font-size: Fonts.size(11px);
                                color: root.status-tone == 0 ? Theme.text-3 : Theme.text-2;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // 作业参数（并发 / 重试），与右侧按钮同宽同高
                        Tag { text: "并发"; }
                        MiniSel {
                            w: 64px;
                            options: root.concurrency-options;
                            index <=> root.concurrency-index;
                            picked(v) => { root.concurrency-changed(root.concurrency-values[v]); }
                        }
                        // 两组参数之间留一道呼吸缝，免得「并发 1 重试 2 次」读成一串
                        Rectangle { width: 8px; height: 1px; }
                        Tag { text: "重试"; }
                        MiniSel {
                            w: 64px;
                            options: root.retry-options;
                            index <=> root.retry-index;
                            picked(v) => { root.retry-changed(root.retry-index); }
                        }
                        VRule { }
                        // 队列操作：三个按钮等宽，主操作用实心琥珀
                        TBtn { label: "开始"; kind: 1; w: 64px; clicked => { root.start-all(); } }
                        TBtn { label: "暂停"; w: 64px; clicked => { root.pause-all(); } }
                        TBtn { label: "取消"; kind: 3; w: 64px; clicked => { root.cancel-all(); } }
                        VRule { }
                        // 多机：点开看有哪些机器在跑、各自槽位与当前任务
                        TBtn { label: root.device-label; w: 64px; clicked => { root.toggle-devices(); } }
                        Rectangle { width: 4px; height: 1px; }
                        // 外观
                        // 与「开始 / 暂停 / 取消」同宽：46px 时两字几乎顶到边框，留白比隔壁按钮
                        // 小一大截，看着像字号不一样。统一 64px 后整排按钮的呼吸感才一致
                        TBtn { label: "字体"; w: 64px; clicked => { root.font-panel-open = true; } }
                        Rectangle { width: 4px; height: 1px; }
                        ThemeSwitch {
                            on: Theme.dark;
                            toggled => { root.toggle-theme(); }
                        }
                    }
                }
            }

            // ── 四栏 ──
            // 宽度一律交给布局：min 兜住不塌，preferred 是常规窗口下的理想宽度，
            // max 防止拉太宽后某一栏空出一大片；horizontal-stretch 决定多余空间怎么分
            // （中栏节点表吃最多，队列卡和日志各分一点）
            HorizontalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 9px;

                // 左：工程
                Panel {
                    min-width: 190px;
                    preferred-width: 202px;
                    max-width: 250px;
                    left-body := VerticalLayout {
                        padding-top: 9px;
                        padding-bottom: 9px;
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 7px;
                        HorizontalLayout {
                            spacing: 6px;
                            Tag { text: "PROJECTS"; }
                            Tag { text: root.project-count; tint: Theme.text-2; }
                            Rectangle { horizontal-stretch: 1; }
                            TBtn { label: "+"; w: 20px; h: 20px; clicked => { root.add-files(); } }
                        }
                        Rule { }
                        shots-sv := ScrollView {
                            VerticalLayout {
                                // 宽度绑面板内宽（不是 root 也不是 ScrollView 自己），
                                // 面板一缩放卡片就跟着走，且不会和 ScrollView 的
                                // preferred-width 形成互相依赖
                                width: left-body.width - 18px;
                                spacing: 2px;
                                for shot[i] in root.shots: card := Rectangle {
                                    // hover 判定要把删除按钮自己算进去，否则鼠标移到 × 上会闪
                                    property <bool> hot: row-ta.has-hover || del-ta.has-hover;
                                    // 高度按三行文字实际撑开（字号倍率 115%~145% 时 46px 装不下，
                                    // 文字会溢出卡片压到下一张上），再夹一层 clip 兜底
                                    height: Math.max(46px, card-lay.preferred-height);
                                    clip: true;
                                    border-radius: 6px;
                                    background: i == root.current-shot ? Theme.accent-soft
                                              : (card.hot ? Theme.hover : transparent);
                                    // 悬停层放在最底层，免得挡住其它可交互子元素
                                    row-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.shot-selected(i); }
                                    }
                                    // 选中时的琥珀导条
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - 24px) / 2;
                                        width: 2px;
                                        height: 24px;
                                        border-radius: 1px;
                                        background: Theme.accent;
                                        opacity: i == root.current-shot ? 1 : 0;
                                    }
                                    card-lay := VerticalLayout {
                                        width: parent.width;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        padding-left: 10px;
                                        padding-right: 24px;
                                        spacing: 0px;
                                        Text {
                                            text: shot.name;
                                            font-size: Fonts.size(12px);
                                            font-weight: 600;
                                            color: i == root.current-shot ? Theme.accent : Theme.text;
                                            overflow: elide;
                                        }
                                        Text { text: shot.sub; font-size: Fonts.size(10px); color: Theme.text-3; overflow: elide; }
                                        // 制作版本 / 使用版本 + 节点数量
                                        Text { text: shot.meta; font-size: Fonts.size(10px); color: Theme.text-3; overflow: elide; }
                                    }
                                    // 状态点：悬停时让位给删除按钮
                                    Rectangle {
                                        x: parent.width - 11px;
                                        y: (parent.height - 5px) / 2;
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: Tone.fg(shot.tone);
                                        visible: !card.hot;
                                    }
                                    // 删除该工程（连同它在执行区里的任务）
                                    del := Rectangle {
                                        x: parent.width - 23px;
                                        y: (parent.height - 17px) / 2;
                                        width: 17px;
                                        height: 17px;
                                        border-radius: 4px;
                                        visible: card.hot;
                                        background: del-ta.has-hover ? Theme.err-soft : transparent;
                                        Text {
                                            text: "×";
                                            font-size: Fonts.size(12px);
                                            color: Theme.err;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        del-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-project(i); }
                                        }
                                    }
                                }
                                if root.shots.length == 0 : Text {
                                    text: "拖入 hip 文件或文件夹\n或点 + 添加";
                                    font-size: Fonts.size(11px);
                                    color: Theme.text-3;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    height: 64px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 中：输出节点（吃掉窗口多余宽度，表里 path 列最需要横向空间）
                Panel {
                    min-width: 440px;
                    // 必须显式给上限：不写的话 Slint 把它当成和 min 一样大，
                    // 整个窗口的最大宽度就被钉在「几栏 max 之和」上，拖不宽
                    max-width: 100000px;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-top: 9px;
                        padding-bottom: 9px;
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 7px;

                        HorizontalLayout {
                            spacing: 6px;
                            Tag { text: "OUTPUT NODES"; }
                            Text {
                                text: root.shot-title;
                                font-size: Fonts.size(11.5px);
                                color: Theme.text-2;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Chip { label: "全选"; w: 38px; clicked => { root.select-all(true); } }
                            Chip { label: "全不选"; w: 46px; clicked => { root.select-all(false); } }
                            Chip { label: "重新解析"; w: 58px; clicked => { root.reanalyze(); } }
                        }

                        // 每个 hip 独立的版本选择：默认「自动」= 跟随 hip 里记录的制作版本
                        HorizontalLayout {
                            spacing: 6px;
                            Tag { text: "HOUDINI 版本"; }
                            ComboBox {
                                model: root.version-options;
                                current-index <=> root.version-index;
                                width: 152px;
                                enabled: root.shots.length > 0;
                                selected(v) => { root.version-changed(root.version-index); }
                            }
                            if root.version-pinned : Tag { text: "已锁定"; tint: Theme.accent; }
                            Text {
                                text: "自动 = 按 hip 的制作版本选；也可手动锁定";
                                font-size: Fonts.size(10.5px);
                                color: Theme.text-3;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 5px;
                            Field {
                                placeholder: "搜索节点 / 路径";
                                horizontal-stretch: 1;
                                edited(t) => { root.search-changed(t); }
                            }
                            Chip { label: "全部"; w: 36px; active: root.filter-index == 0; clicked => { root.filter-changed(0); } }
                            Chip { label: "缓存"; w: 36px; active: root.filter-index == 1; clicked => { root.filter-changed(1); } }
                            Chip { label: "渲染"; w: 36px; active: root.filter-index == 2; clicked => { root.filter-changed(2); } }
                            VRule { }
                            Chip { label: "只看未加入"; w: 72px; active: root.only-unadded; clicked => { root.toggle-unadded(); } }
                        }

                        // 列头
                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            Rectangle { width: 24px; }
                            Tag { text: "NODE"; horizontal-stretch: 1; }
                            Tag { text: "类型"; width: 108px; }
                            Tag { text: "分类"; width: 44px; }
                            Tag { text: "帧范围"; width: 100px; }
                            Tag { text: "状态"; width: 60px; }
                        }
                        Rule { }

                        // 节点表：ListView 只实例化看得见的那几行。之前用 ScrollView 装
                        // VerticalLayout，几千个节点时点一下勾选会整表重建，界面卡 0.7 秒
                        Rectangle {
                            vertical-stretch: 1;
                            nodes-lv := ListView {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                visible: root.nodes.length > 0;
                                for node[i] in root.nodes: Rectangle {
                                    width: nodes-lv.visible-width;
                                    // 单行显示：高度跟着字号走，避免大字号下压到下一行
                                    height: Math.max(26px, Fonts.size(12px) + 13px);
                                    background: node-ta.has-hover ? Theme.hover : (Math.mod(i, 2) == 1 ? Theme.row-alt : transparent);
                                    // 悬停层在最底层，勾选框和帧范围输入框才收得到点击；
                                    // 点行内任意空白处也切换勾选，省得非要去点小方框
                                    node-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-node(i); }
                                    }
                                    HorizontalLayout {
                                        width: parent.width;
                                        spacing: 8px;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Check {
                                            on: node.checked;
                                            toggled => { root.toggle-node(i); }
                                        }
                                        Text {
                                            text: node.path;
                                            horizontal-stretch: 1;
                                            font-size: Fonts.size(12px);
                                            font-weight: 600;
                                            color: node.checked ? Theme.text : Theme.text-2;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: node.ntype;
                                            width: 108px;
                                            font-family: Fonts.mono;
                                            font-size: Fonts.size(9px);
                                            color: Theme.text-2;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // 定高的小控件在行布局里默认贴顶，各包一层竖直居中的容器，
                                        // 宽度与列头保持一致，列才不会错位
                                        VerticalLayout {
                                            width: 44px;
                                            alignment: center;
                                            Badge {
                                                label: node.category;
                                                w: 42px;
                                                tone: node.category == "渲染" ? 4 : 5;
                                            }
                                        }
                                        VerticalLayout {
                                            width: 100px;
                                            alignment: center;
                                            Field {
                                                w: 100px;
                                                h: 20px;
                                                // 不连续帧会长到 1052,1055-1056,1065-1070，
                                                // 居中会让两头同时被裁，改成左对齐
                                                centered: false;
                                                text: node.range;
                                                // 非法只标红这一格，不碰行模型、不打断输入
                                                invalid: root.range-invalid == i;
                                                edited(t) => { root.range-edited(i, t); }
                                                committed(t) => { root.range-committed(i, t); }
                                            }
                                        }
                                        VerticalLayout {
                                            width: 60px;
                                            alignment: center;
                                            Badge {
                                                label: node.status;
                                                w: 60px;
                                                tone: node.tone;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.nodes.length == 0 : Text {
                                text: root.node-empty-hint;
                                font-size: Fonts.size(11px);
                                color: Theme.text-3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                height: 90px;
                            }
                        }
                    }
                }

                // 右：执行区
                Panel {
                    min-width: 262px;
                    preferred-width: 298px;
                    max-width: 380px;
                    horizontal-stretch: 0.2;
                    q-body := VerticalLayout {
                        padding-top: 9px;
                        padding-bottom: 9px;
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 7px;
                        HorizontalLayout {
                            spacing: 6px;
                            Tag { text: "QUEUE"; }
                            Tag { text: root.queue-count; tint: Theme.text-2; }
                            Rectangle { horizontal-stretch: 1; }
                            Chip { label: "清空完成"; w: 58px; clicked => { root.clear-finished(); } }
                            // 重新开始：清零所有帧进度并重跑整批。误触代价高（会重渲所有帧），
                            // 所以做成两步：先点亮成「确认重跑」，4 秒内再点一次才执行
                            Rectangle { width: 2px; height: 1px; }
                            Chip {
                                label: root.restart-armed ? "确认重跑" : "重新开始";
                                w: 66px;
                                active: root.restart-armed;
                                clicked => {
                                    if (root.restart-armed) {
                                        root.restart-armed = false;
                                        restart-timer.running = false;
                                        root.restart-all();
                                    } else {
                                        root.restart-armed = true;
                                        restart-timer.running = true;
                                    }
                                }
                            }
                        }
                        Rule { }
                        queue-sv := ScrollView {
                            VerticalLayout {
                                width: q-body.width - 18px;
                                spacing: 5px;
                                for t[i] in root.queue: Rectangle {
                                    // 同左栏：高度跟内容走，大字号下不会压到下一张卡片
                                    height: Math.max(50px, q-lay.preferred-height);
                                    clip: true;
                                    border-radius: 7px;
                                    background: t.tone == 1 ? Theme.run-soft : (card-ta.has-hover ? Theme.hover : Theme.well);
                                    border-width: 1px;
                                    border-color: t.tone == 1 ? Theme.run-line
                                                : t.tone == 3 ? Theme.err-line
                                                : t.tone == 2 ? Theme.ok-line
                                                : Theme.border;
                                    card-ta := TouchArea { }
                                    q-lay := VerticalLayout {
                                        width: parent.width;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: t.title;
                                                font-size: Fonts.size(11.5px);
                                                font-weight: 600;
                                                color: Theme.text;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            // 排序箭头：到顶/到底时置灰
                                            ArrowBtn { dir-up: true; can-move: i > 0; clicked => { root.task-up(t.nid); } }
                                            ArrowBtn { dir-up: false; can-move: i + 1 < root.queue.length; clicked => { root.task-down(t.nid); } }
                                            IconBtn { glyph: "×"; kind: 1; clicked => { root.task-cancel(t.nid); } }
                                            Badge { label: t.status; w: 42px; tone: t.tone; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: t.shot + " · " + t.category + " · " + t.range;
                                                font-family: Fonts.mono;
                                                font-size: Fonts.size(10px);
                                                color: Theme.text-3;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: t.frames;
                                                font-family: Fonts.mono;
                                                font-size: Fonts.size(10px);
                                                color: Theme.text-2;
                                            }
                                        }
                                        Progress { value: t.progress; tone: t.tone == 0 ? 1 : t.tone; }
                                    }
                                }
                                if root.queue.length == 0 : Text {
                                    text: "勾选节点即自动入队\n缓存排在渲染之前";
                                    font-size: Fonts.size(11px);
                                    color: Theme.text-3;
                                    horizontal-alignment: center;
                                    height: 64px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // 最右：日志（独立一列）
                Panel {
                    min-width: 280px;
                    preferred-width: 360px;
                    max-width: 620px;
                    horizontal-stretch: 0.5;
                    log-body := VerticalLayout {
                        padding-top: 9px;
                        padding-bottom: 9px;
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 7px;
                        HorizontalLayout {
                            spacing: 6px;
                            Tag { text: "LOG"; }
                            Rectangle { horizontal-stretch: 1; }
                            Chip { label: "跟随"; w: 42px; active: root.follow-log; clicked => { root.follow-log = !root.follow-log; } }
                            Chip { label: "导出"; w: 42px; clicked => { root.export-log(); } }
                        }
                        Rule { }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.dark ? #0c0e11 : #fbfaf8;
                            log-sv := ScrollView {
                                // 宽度必须钉在面板上：ScrollView 不写 width 会按「内容理想宽度」撑开，
                                // 日志里一出现超长行（长路径 / 整段 hython 报错）就把视口撑到 500+px，
                                // 里面写死宽度的布局再被居中 → 整块文字右移、右半边被裁掉
                                width: parent.width;
                                height: parent.height;
                                VerticalLayout {
                                    width: log-body.width - 20px;
                                    padding-top: 7px;
                                    padding-bottom: 7px;
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    alignment: start;
                                    Text {
                                        // 宽度必须是明确长度：写 100% 时 Text 的理想宽度仍按最长的
                                        // 不可断词算，会把 ScrollView 内容撑到 430+，布局再被居中右移
                                        width: log-body.width - 42px;
                                        text: root.log-text;
                                        font-size: Fonts.size(10.5px);
                                        color: Theme.dark ? #a8a49b : #55534e;
                                        font-family: Fonts.mono;
                                        wrap: word-wrap;
                                        horizontal-alignment: left;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 底部状态栏 ──
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                border-radius: 6px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 8px;
                    Tag { text: "HIP"; }
                    Text {
                        text: root.status-hip == "" ? "未选择工程 · 拖入 hip 文件开始" : root.status-hip;
                        horizontal-stretch: 1;
                        font-family: Fonts.mono;
                        font-size: Fonts.size(10.5px);
                        color: root.status-hip == "" ? Theme.text-3 : Theme.text-2;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    VRule { }
                    Text {
                        text: root.status-meta;
                        font-family: Fonts.mono;
                        font-size: Fonts.size(10.5px);
                        color: Theme.text-3;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── 设备面板 ──
        // 从右上角展开的浮层。遮罩铺满整窗，点空白处关闭；卡片自己吃掉点击，
        // 否则点在面板空白处会被下层遮罩当成「点外面」直接关掉。
        if root.devices-open : Rectangle {
            background: #00000055;
            TouchArea {
                clicked => { root.devices-open = false; }
            }
            dev-card := Rectangle {
                x: parent.width - self.width - 14px;
                y: 58px;
                width: 380px;
                height: Math.max(110px, dev-body.preferred-height + 4px);
                border-radius: 10px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border-2;
                TouchArea { }
                dev-body := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "执行设备";
                            font-size: Fonts.size(12px);
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TBtn { label: "关闭"; w: 46px; h: 21px; clicked => { root.devices-open = false; } }
                    }
                    Rule { }

                    for dev in root.devices : VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Tone.fg(dev.tone);
                                y: (parent.height - 6px) / 2;
                            }
                            Text {
                                text: dev.host;
                                font-size: Fonts.size(11.5px);
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Tag { text: dev.slots; }
                            Tag { text: dev.state; tint: Tone.fg(dev.tone); }
                        }
                        Text {
                            text: dev.houdini;
                            font-size: Fonts.size(10px);
                            color: Theme.text-3;
                            overflow: elide;
                        }
                        Text {
                            text: dev.job;
                            font-size: Fonts.size(10px);
                            color: Theme.text-2;
                            overflow: elide;
                            visible: dev.job != "";
                        }
                    }

                    if root.devices.length == 0 : Text {
                        text: "还没有其他机器接入";
                        font-size: Fonts.size(11px);
                        color: Theme.text-3;
                    }

                    Rule { }
                    Text {
                        text: root.device-hint;
                        font-size: Fonts.size(10px);
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // 拖入提示：有文件悬停在窗口上时整窗描边（由 Rust 侧 OLE 事件驱动）
        Rectangle {
            visible: root.drag-hover;
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            border-width: 2px;
            border-color: Theme.accent;
            border-radius: 11px;
            background: transparent;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 12px;
                width: 128px;
                height: 26px;
                border-radius: 13px;
                background: Theme.accent;
                Text {
                    text: "松开即导入";
                    color: Theme.accent-fg;
                    font-size: Fonts.size(12px);
                    font-weight: 600;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 注意：Slint 1.19 的 winit 后端收不到系统级文件拖放，从资源管理器拖入走的是
        // Rust 侧 windrop.rs（OLE IDropTarget）。这里保留 DropArea 只为应用内部拖拽。
        DropArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            can-drop(e) => { return DragAction.copy; }
            dropped(e) => {
                root.drop-transfer(e.data);
                return DragAction.copy;
            }
        }

        // ── 字体设置浮层 ──
        Rectangle {
            visible: root.font-panel-open;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000aa;
            // 点遮罩关闭
            ta-mask := TouchArea {
                clicked => { root.font-panel-open = false; }
            }
            Rectangle {
                x: (parent.width - 500px) / 2;
                y: (parent.height - 372px) / 2;
                width: 500px;
                height: 372px;
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border-2;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "字体设置";
                        font-size: Fonts.size(16px);
                        font-weight: 600;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Tag { text: "界面字体"; width: 76px; }
                        fam-box := ComboBox {
                            model: root.font-families;
                            current-index <=> root.font-family-index;
                            horizontal-stretch: 1;
                            selected(v) => { root.font-changed(); }
                        }
                    }
                    // 搜索框与上面的下拉同宽，输入即过滤（只筛下拉，不写库、不改当前字体）
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle { width: 76px; height: 1px; }
                        Field {
                            w: fam-box.width;
                            h: 30px;
                            placeholder: "搜索字体：宋体 / Noto / Consolas";
                            text <=> root.font-filter;
                            edited(t) => { root.font-filter-changed(t); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Tag { text: "字号"; width: 76px; }
                        ComboBox {
                            model: root.font-size-labels;
                            current-index <=> root.font-size-index;
                            width: 180px;
                            selected(v) => { root.font-changed(); }
                        }
                    }
                    Rectangle {
                        height: 66px;
                        border-radius: 7px;
                        background: Theme.well;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding-left: 13px;
                            padding-top: 9px;
                            spacing: 3px;
                            Text {
                                text: "预览 · Houdini 渲染队列";
                                font-size: Fonts.size(13px);
                                font-weight: 600;
                                color: Theme.text;
                            }
                            Text {
                                text: "/stage/bg   usdrender_rop   1001-1072   已加入执行区";
                                color: Theme.text-2;
                            }
                        }
                    }
                    Text {
                        text: "修改后立即生效并保存，下次启动依然保持";
                        font-size: Fonts.size(10px);
                        color: Theme.text-3;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        TBtn {
                            label: "恢复默认";
                            w: 84px;
                            clicked => {
                                // 先清过滤词：否则下拉里可能没有「系统默认」这一项，index=0 会落到别的字体上
                                root.font-filter = "";
                                root.font-filter-changed("");
                                root.font-family-index = 0;
                                root.font-size-index = 1;
                                root.font-changed();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TBtn { label: "关闭"; kind: 1; w: 70px; clicked => { root.font-panel-open = false; } }
                    }
                }
            }
        }
    }
}
